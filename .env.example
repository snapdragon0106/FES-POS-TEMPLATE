# Copy to .env (git-ignored) for local runs. On Render the same keys are set
# in the service's Environment settings (render.yaml asks for them when the
# service is created). The real values must never be committed: anything in
# shared/ or client/ is also shipped to every visitor.
# Setup steps for people new to this: docs/FES-POSセットアップ手順書.pdf

# TiDB / MySQL connection string. The database at the end (/fespos) is created
# on first start if it doesn't exist; change the name to start a new year empty.
DATABASE_URL=mysql://user:password@host:4000/fespos

# Signs session and 合言葉 cookies. At least 32 random characters.
# (render.yaml has Render generate it.)
JWT_SECRET=change-me-to-at-least-32-random-characters

# Roster: 番号:名前, separated by commas (or one per line). A JSON object
# such as {"3501":"山田 太郎"} also works.
POS_MEMBERS=3501:山田 太郎,3502:佐藤 花子

# Member IDs with admin rights, comma-separated (two admins: 3501,3502)
POS_ADMIN_IDS=3501

# The 合言葉 entered on the first screen
POS_ACCESS_CODE=ここに合言葉

# The shop's name, shown on the login page (optional). e.g. 経高祭 3年5組
POS_SHOP_NAME=

# Lets the admin set their PIN with this code: the very first PIN of a new
# shop, or a forgotten one (at least 16 characters; empty = off).
# (render.yaml has Render generate it.)
POS_ADMIN_RECOVERY_CODE=

# Cloudflare Turnstile on the 合言葉 and PIN forms (optional; both or neither).
# Cloudflare dashboard → Turnstile → Add widget (hostname <your-service>.onrender.com,
# plus localhost for local runs; Managed). Empty = off. Cloudflare's test keys
# for local runs: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
